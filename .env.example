# Configure in Vercel Project Settings > Environment Variables. Never commit actual values.
MONGODB_URI=
MONGODB_DB_NAME=geonexa
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ENABLE_PUBLIC_AI=false

# Private GeoMind remote inference bridge. OFF by default.
# A Kaggle notebook run is not a persistent inference endpoint.
GEONEXA_REMOTE_INFERENCE_ENABLED=false
# HTTPS OpenAI-compatible /v1/chat/completions URL on Hugging Face.
# Examples: https://router.huggingface.co/v1/chat/completions
# or a dedicated https://<id>.<region>.aws.endpoints.huggingface.cloud/v1/chat/completions
GEONEXA_INFERENCE_ENDPOINT_URL=
# Cloud inference provider secret. Server-only, never NEXT_PUBLIC_*.
GEONEXA_INFERENCE_API_KEY=
# Provider-side model ID / deployed model identifier.
GEONEXA_INFERENCE_MODEL=
# Unique random secret (at least 32 chars) used only for private owner tests.
GEONEXA_INFERENCE_OWNER_TOKEN=
